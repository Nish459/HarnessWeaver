{
  "name": "@harnessweaver/core",
  "version": "0.4.1",
  "description": "The HarnessWeaver core for TypeScript: the same harness.yaml, hook bus, guards, governor and routing as Python.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wise-DreamerZ/HarnessWeaver.git",
    "directory": "typescript/packages/core"
  },
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sync": "node scripts/sync-contracts.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
