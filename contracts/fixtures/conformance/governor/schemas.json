{
  "suite": "governor",
  "description": "Governor step 2: the JSON Schema subset tool arguments are checked against (ADR-0026). Problems are compared by location only: dotted names, [i] for array items, (root) for the value itself.",
  "cases": [
    {"name": "a required property is missing",
     "schema": {"type": "object", "properties": {"amount_usd": {"type": "number"}}, "required": ["amount_usd"]},
     "value": {}, "expect": {"valid": false, "locations": ["amount_usd"]}},
    {"name": "a string is not a number",
     "schema": {"type": "object", "properties": {"amount_usd": {"type": "number"}}},
     "value": {"amount_usd": "12"}, "expect": {"valid": false, "locations": ["amount_usd"]}},
    {"name": "a boolean is not a number",
     "schema": {"type": "number"}, "value": true, "expect": {"valid": false, "locations": ["(root)"]}},
    {"name": "an integer may be written with a zero fraction",
     "schema": {"type": "integer"}, "value": 3.0, "expect": {"valid": true}},
    {"name": "a fraction is not an integer",
     "schema": {"type": "integer"}, "value": 3.5, "expect": {"valid": false, "locations": ["(root)"]}},
    {"name": "a type list accepts any of its types",
     "schema": {"type": ["string", "null"]}, "value": null, "expect": {"valid": true}},
    {"name": "extra properties can be refused",
     "schema": {"type": "object", "properties": {"a": {}}, "additionalProperties": false},
     "value": {"a": 1, "b": 2}, "expect": {"valid": false, "locations": ["b"]}},
    {"name": "extra properties can be checked against a schema",
     "schema": {"type": "object", "additionalProperties": {"type": "integer"}},
     "value": {"a": 1, "b": "two"}, "expect": {"valid": false, "locations": ["b"]}},
    {"name": "array items are checked with their index",
     "schema": {"type": "object", "properties": {"lines": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sku"], "properties": {"sku": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]+$"}}}}}},
     "value": {"lines": [{"sku": "ABC-1"}, {"sku": "bad"}, {}]},
     "expect": {"valid": false, "locations": ["lines[1].sku", "lines[2].sku"]}},
    {"name": "too few items",
     "schema": {"type": "array", "minItems": 1}, "value": [], "expect": {"valid": false, "locations": ["(root)"]}},
    {"name": "a value outside the enum",
     "schema": {"enum": ["low", "high"]}, "value": "mid", "expect": {"valid": false, "locations": ["(root)"]}},
    {"name": "a constant",
     "schema": {"const": {"kind": "refund"}}, "value": {"kind": "refund"}, "expect": {"valid": true}},
    {"name": "an exclusive maximum excludes the limit",
     "schema": {"type": "number", "minimum": 0, "exclusiveMaximum": 1000}, "value": 1000,
     "expect": {"valid": false, "locations": ["(root)"]}},
    {"name": "a minimum includes the limit",
     "schema": {"type": "number", "minimum": 0, "exclusiveMaximum": 1000}, "value": 0, "expect": {"valid": true}},
    {"name": "string length counts characters",
     "schema": {"type": "string", "minLength": 2, "maxLength": 3}, "value": "a",
     "expect": {"valid": false, "locations": ["(root)"]}},
    {"name": "a pattern is searched, not anchored",
     "schema": {"type": "string", "pattern": "[0-9]{4}"}, "value": "order 2026 shipped", "expect": {"valid": true}},
    {"name": "anyOf needs one match",
     "schema": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "value": 1.5,
     "expect": {"valid": false, "locations": ["(root)"]}},
    {"name": "oneOf refuses a value that matches two",
     "schema": {"oneOf": [{"type": "integer"}, {"type": "number"}]}, "value": 2,
     "expect": {"valid": false, "locations": ["(root)"]}},
    {"name": "oneOf accepts a value that matches exactly one",
     "schema": {"oneOf": [{"type": "integer"}, {"type": "number"}]}, "value": 2.5, "expect": {"valid": true}},
    {"name": "not",
     "schema": {"not": {"type": "null"}}, "value": null, "expect": {"valid": false, "locations": ["(root)"]}},
    {"name": "references to $defs",
     "schema": {"$defs": {"money": {"type": "number", "minimum": 0}}, "type": "object", "properties": {"amount": {"$ref": "#/$defs/money"}}},
     "value": {"amount": -1}, "expect": {"valid": false, "locations": ["amount"]}},
    {"name": "unique items compare canonical values",
     "schema": {"type": "array", "uniqueItems": true}, "value": [1, 1.0],
     "expect": {"valid": false, "locations": ["(root)"]}},
    {"name": "multipleOf works with decimal steps",
     "schema": {"type": "number", "multipleOf": 0.01}, "value": 10.25, "expect": {"valid": true}},
    {"name": "multipleOf refuses a finer value",
     "schema": {"type": "number", "multipleOf": 0.01}, "value": 10.255,
     "expect": {"valid": false, "locations": ["(root)"]}},
    {"name": "property counts",
     "schema": {"type": "object", "minProperties": 1}, "value": {}, "expect": {"valid": false, "locations": ["(root)"]}},
    {"name": "annotations are ignored",
     "schema": {"type": "string", "title": "Reason", "description": "Why", "format": "email", "examples": ["x"]},
     "value": "not an email", "expect": {"valid": true}},
    {"name": "an unsupported keyword fails the schema itself",
     "schema": {"type": "object", "patternProperties": {"^x": {"type": "string"}}},
     "value": {}, "expect": {"error": "unsupported"}},
    {"name": "a reference outside the document fails the schema itself",
     "schema": {"$ref": "other.json#/money"}, "value": 1, "expect": {"error": "unsupported"}},
    {"name": "an unknown type fails the schema itself",
     "schema": {"type": "decimal"}, "value": 1, "expect": {"error": "unsupported"}},
    {"name": "keys named after Object.prototype members aren't declared properties", "schema": {"type": "object", "properties": {"account": {"type": "string"}}, "additionalProperties": false}, "value": {"account": "a", "constructor": 1, "toString": 2, "hasOwnProperty": 3}, "expect": {"valid": false, "locations": ["constructor", "hasOwnProperty", "toString"]}},
    {"name": "a __proto__ key isn't a declared property", "schema": {"type": "object", "properties": {"account": {"type": "string"}}, "additionalProperties": false}, "value": {"account": "a", "__proto__": {}}, "expect": {"valid": false, "locations": ["__proto__"]}},
    {"name": "a required name is not satisfied by Object.prototype", "schema": {"type": "object", "required": ["constructor"]}, "value": {}, "expect": {"valid": false, "locations": ["constructor"]}},
    {"name": "a declared constructor property is checked by its own schema", "schema": {"type": "object", "properties": {"constructor": {"type": "string"}}}, "value": {"constructor": 1}, "expect": {"valid": false, "locations": ["constructor"]}}
  ]
}
