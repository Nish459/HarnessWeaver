{
  "suite": "governor",
  "description": "Governor step 3: how every PolicyEngine combines policy.rules (ADR-0025). The expressions are valid in cel-lite and in full CEL.",
  "cases": [
    {"name": "no rules: the default decides a tool call",
     "rules": [], "default_effect": "allow",
     "request": {"principal": {"id": "alice"}, "tenant": "acme", "tool": {"name": "refund"}, "args": {"amount_usd": 20}},
     "expect": {"effect": "allow", "rule": null}},
    {"name": "a deny-by-default policy",
     "rules": [{"id": "small", "when": "args.amount_usd < 50", "effect": "allow"}], "default_effect": "deny",
     "request": {"principal": {"id": "alice"}, "tenant": "acme", "tool": {"name": "refund"}, "args": {"amount_usd": 200}},
     "expect": {"effect": "deny", "rule": null}},
    {"name": "a matching allow rule beats a deny default",
     "rules": [{"id": "small", "when": "args.amount_usd < 50", "effect": "allow"}], "default_effect": "deny",
     "request": {"principal": {"id": "alice"}, "tenant": "acme", "tool": {"name": "refund"}, "args": {"amount_usd": 20}},
     "expect": {"effect": "allow", "rule": "small"}},
    {"name": "deny beats require_approval, whatever the order",
     "rules": [
       {"id": "big", "when": "args.amount_usd > 100", "effect": "require_approval"},
       {"id": "contractors", "when": "'contractor' in principal.roles", "effect": "deny"}
     ],
     "default_effect": "allow",
     "request": {"principal": {"id": "carl", "roles": ["contractor"]}, "tenant": "acme", "tool": {"name": "refund"}, "args": {"amount_usd": 500}},
     "expect": {"effect": "deny", "rule": "contractors"}},
    {"name": "require_approval beats allow",
     "rules": [
       {"id": "support", "when": "'support' in principal.roles", "effect": "allow"},
       {"id": "high-risk", "when": "tool.risk == 'high'", "effect": "require_approval"}
     ],
     "default_effect": "deny",
     "request": {"principal": {"id": "alice", "roles": ["support"]}, "tenant": "acme", "tool": {"name": "refund", "risk": "high"}, "args": {}},
     "expect": {"effect": "require_approval", "rule": "high-risk"}},
    {"name": "among equal effects the first rule decides",
     "rules": [
       {"id": "big", "when": "args.amount_usd > 100", "effect": "require_approval"},
       {"id": "foreign", "when": "args.currency != 'USD'", "effect": "require_approval"}
     ],
     "default_effect": "allow",
     "request": {"principal": {"id": "alice"}, "tenant": "acme", "tool": {"name": "refund"}, "args": {"amount_usd": 500, "currency": "EUR"}},
     "expect": {"effect": "require_approval", "rule": "big"}},
    {"name": "a deny rule that can't be evaluated still denies",
     "rules": [{"id": "limit", "when": "args.order.total > 1000", "effect": "deny"}], "default_effect": "allow",
     "request": {"principal": {"id": "alice"}, "tenant": "acme", "tool": {"name": "refund"}, "args": {}},
     "expect": {"effect": "deny", "rule": "limit"}},
    {"name": "an approval rule that can't be evaluated still asks",
     "rules": [{"id": "limit", "when": "args.order.total > 1000", "effect": "require_approval"}], "default_effect": "allow",
     "request": {"principal": {"id": "alice"}, "tenant": "acme", "tool": {"name": "refund"}, "args": {}},
     "expect": {"effect": "require_approval", "rule": "limit"}},
    {"name": "an allow rule that can't be evaluated grants nothing",
     "rules": [{"id": "vip", "when": "args.customer.vip", "effect": "allow"}], "default_effect": "deny",
     "request": {"principal": {"id": "alice"}, "tenant": "acme", "tool": {"name": "refund"}, "args": {}},
     "expect": {"effect": "deny", "rule": null}},
    {"name": "labels can be used",
     "rules": [{"id": "tainted", "when": "labels.untrusted_seen && size(tool.egress) > 0", "effect": "require_approval"}], "default_effect": "allow",
     "request": {"principal": {"id": "alice"}, "tenant": "acme", "tool": {"name": "email", "egress": ["mail.example.com"]}, "args": {}, "labels": {"untrusted_seen": true}},
     "expect": {"effect": "require_approval", "rule": "tainted"}},
    {"name": "run.start: only run.start rules apply, and the default is allow",
     "rules": [
       {"id": "big", "when": "args.amount_usd > 100", "effect": "deny"},
       {"id": "night-shift", "when": "'contractor' in principal.roles", "effect": "deny", "hook": "run.start"}
     ],
     "default_effect": "deny",
     "request": {"hook": "run.start", "principal": {"id": "alice", "roles": ["support"]}, "tenant": "acme", "task": "refunds"},
     "expect": {"effect": "allow", "rule": null}},
    {"name": "run.start: a rule can deny a run",
     "rules": [{"id": "contractors", "when": "'contractor' in principal.roles && task.name == 'refunds'", "effect": "deny", "hook": "run.start"}],
     "default_effect": "allow",
     "request": {"hook": "run.start", "principal": {"id": "carl", "roles": ["contractor"]}, "tenant": "acme", "task": "refunds"},
     "expect": {"effect": "deny", "rule": "contractors"}},
    {"name": "tool rules don't apply at run.start",
     "rules": [{"id": "always", "when": "true", "effect": "deny"}],
     "default_effect": "allow",
     "request": {"hook": "run.start", "principal": {"id": "alice"}, "tenant": "acme"},
     "expect": {"effect": "allow", "rule": null}}
  ]
}
