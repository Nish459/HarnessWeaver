{
  "suite": "evals",
  "description": "The deterministic graders. A grader is written as in a dataset; it sees a sample (output, expect, status, the guards that fired, the task's output_schema; status defaults to completed). Deterministic graders score 1 when they pass and 0 otherwise. Text graders read a string output as it is and any other output as canonical JSON: sorted keys, no spaces, non-ASCII kept, integral numbers without a fraction. error is 'unknown' for a grader that doesn't exist and 'invalid' for bad settings.",
  "cases": [
    { "name": "exact compares JSON values; numbers by value", "grader": "exact",
      "sample": { "output": { "a": 1, "b": [1, 2.0] }, "expect": { "b": [1.0, 2], "a": 1.0 } }, "expect": { "passed": true } },
    { "name": "exact: a boolean isn't a number", "grader": "exact",
      "sample": { "output": { "a": true }, "expect": { "a": 1 } }, "expect": { "passed": false } },
    { "name": "exact: strings are case-sensitive", "grader": "exact",
      "sample": { "output": "Yes", "expect": "yes" }, "expect": { "passed": false } },
    { "name": "exact takes no settings", "grader": { "exact": true }, "expect": { "error": "invalid" } },

    { "name": "field_equals compares one field", "grader": { "field_equals": "invoice_number" },
      "sample": { "output": { "invoice_number": "7781", "total": 50 }, "expect": { "invoice_number": "7781" } }, "expect": { "passed": true } },
    { "name": "field_equals follows dotted paths and list indexes", "grader": { "field_equals": "line_items.1.amount" },
      "sample": { "output": { "line_items": [ { "amount": 750 }, { "amount": 800.0 } ] }, "expect": { "line_items": [ { "amount": 0 }, { "amount": 800 } ] } }, "expect": { "passed": true } },
    { "name": "field_equals fails when the output lacks the field", "grader": { "field_equals": "invoice_number" },
      "sample": { "output": { "total": 5 }, "expect": { "invoice_number": "x" } }, "expect": { "passed": false } },
    { "name": "field_equals fails when the case expects nothing there", "grader": { "field_equals": "invoice_number" },
      "sample": { "output": { "invoice_number": "x" }, "expect": { "total": 5 } }, "expect": { "passed": false } },
    { "name": "field_equals: a string isn't a number", "grader": { "field_equals": "invoice_number" },
      "sample": { "output": { "invoice_number": "7781" }, "expect": { "invoice_number": 7781 } }, "expect": { "passed": false } },
    { "name": "field_equals needs a field", "grader": { "field_equals": {} }, "expect": { "error": "invalid" } },

    { "name": "numeric_close within the tolerance", "grader": { "numeric_close": { "field": "total", "tolerance": 0.01 } },
      "sample": { "output": { "total": 1860.004 }, "expect": { "total": 1860 } }, "expect": { "passed": true } },
    { "name": "numeric_close outside the tolerance", "grader": { "numeric_close": { "field": "total", "tolerance": 0.01 } },
      "sample": { "output": { "total": 1860.5 }, "expect": { "total": 1860 } }, "expect": { "passed": false } },
    { "name": "numeric_close shorthand names the field", "grader": { "numeric_close": "total" },
      "sample": { "output": { "total": 50.0 }, "expect": { "total": 50 } }, "expect": { "passed": true } },
    { "name": "numeric_close without a field compares the whole output", "grader": "numeric_close",
      "sample": { "output": 0.3, "expect": 0.30000000000000004 }, "expect": { "passed": true } },
    { "name": "numeric_close: text isn't a number", "grader": { "numeric_close": "total" },
      "sample": { "output": { "total": "50" }, "expect": { "total": 50 } }, "expect": { "passed": false } },
    { "name": "numeric_close: a boolean isn't a number", "grader": { "numeric_close": "total" },
      "sample": { "output": { "total": true }, "expect": { "total": 1 } }, "expect": { "passed": false } },
    { "name": "numeric_close: the tolerance can't be negative", "grader": { "numeric_close": { "field": "total", "tolerance": -1 } }, "expect": { "error": "invalid" } },

    { "name": "contains a phrase", "grader": { "contains": "five business days" },
      "sample": { "output": "Refunds take five business days [kb-1]." }, "expect": { "passed": true } },
    { "name": "contains every listed text, case-sensitively", "grader": { "contains": ["refund", "days"] },
      "sample": { "output": "Refunds take five business days." }, "expect": { "passed": false } },
    { "name": "contains, ignoring case", "grader": { "contains": { "text": ["refund", "DAYS"], "ignore_case": true } },
      "sample": { "output": "Refunds take five business days." }, "expect": { "passed": true } },
    { "name": "contains reads structured output as canonical JSON", "grader": { "contains": "\"category\":\"billing\"" },
      "sample": { "output": { "priority": 2, "category": "billing" } }, "expect": { "passed": true } },
    { "name": "canonical JSON writes integral numbers without a fraction", "grader": { "contains": "{\"total\":1860}" },
      "sample": { "output": { "total": 1860.0 } }, "expect": { "passed": true } },
    { "name": "canonical JSON keeps non-ASCII text", "grader": { "contains": "\"caf\u00e9\"" },
      "sample": { "output": { "name": "caf\u00e9" } }, "expect": { "passed": true } },
    { "name": "a null output is empty text", "grader": { "contains": "x" },
      "sample": { "output": null }, "expect": { "passed": false } },

    { "name": "regex searches the text", "grader": { "regex": "INV-\\d{4}-\\d{4}" },
      "sample": { "output": { "invoice_number": "INV-2026-0042" } }, "expect": { "passed": true } },
    { "name": "regex anchors at the start", "grader": { "regex": "^Refunds" },
      "sample": { "output": "Refunds take five business days." }, "expect": { "passed": true } },
    { "name": "regex that doesn't match", "grader": { "regex": "^take" },
      "sample": { "output": "Refunds take five business days." }, "expect": { "passed": false } },
    { "name": "regex must compile", "grader": { "regex": "(" }, "expect": { "error": "invalid" } },

    { "name": "schema_valid against the task's output schema", "grader": "schema_valid",
      "sample": { "output": { "total": 5 }, "output_schema": { "type": "object", "required": ["total"], "properties": { "total": { "type": "number" } } } }, "expect": { "passed": true } },
    { "name": "schema_valid with a wrong type", "grader": "schema_valid",
      "sample": { "output": { "total": "5" }, "output_schema": { "type": "object", "required": ["total"], "properties": { "total": { "type": "number" } } } }, "expect": { "passed": false } },
    { "name": "schema_valid fails a run that didn't complete", "grader": "schema_valid",
      "sample": { "output": null, "status": "failed", "output_schema": { "type": "object" } }, "expect": { "passed": false } },
    { "name": "schema_valid without a schema needs an output", "grader": "schema_valid",
      "sample": { "output": "ok" }, "expect": { "passed": true } },
    { "name": "schema_valid without a schema fails a null output", "grader": "schema_valid",
      "sample": { "output": null }, "expect": { "passed": false } },

    { "name": "citation_present finds a citation", "grader": "citation_present",
      "sample": { "output": "Refunds take five business days [kb-1]." }, "expect": { "passed": true } },
    { "name": "citation_present without one", "grader": "citation_present",
      "sample": { "output": "Refunds take five business days." }, "expect": { "passed": false } },
    { "name": "citation_present with every listed id", "grader": { "citation_present": ["kb-1", "kb-2"] },
      "sample": { "output": "A [kb-1]. B [kb-2]." }, "expect": { "passed": true } },
    { "name": "citation_present missing a listed id", "grader": { "citation_present": ["kb-1", "kb-2"] },
      "sample": { "output": "A [kb-1]. B." }, "expect": { "passed": false } },
    { "name": "citation_present reads structured output", "grader": { "citation_present": "kb-1" },
      "sample": { "output": { "answer": "See [kb-1]" } }, "expect": { "passed": true } },

    { "name": "guard_fired by the guard's id", "grader": { "guard_fired": "injection" },
      "sample": { "output": null, "status": "blocked", "guards": [ { "guard": "guardrails.input[injection]", "action": "block", "shadow": false } ] }, "expect": { "passed": true } },
    { "name": "guard_fired by the guard's full name", "grader": { "guard_fired": "guardrails.input[injection]" },
      "sample": { "output": null, "status": "blocked", "guards": [ { "guard": "guardrails.input[injection]", "action": "block", "shadow": false } ] }, "expect": { "passed": true } },
    { "name": "a shadow guard that would fire counts", "grader": { "guard_fired": "toxicity" },
      "sample": { "output": "x", "guards": [ { "guard": "guardrails.output[toxicity]", "action": "block", "shadow": true } ] }, "expect": { "passed": true } },
    { "name": "guard_fired when nothing fired", "grader": { "guard_fired": "injection" },
      "sample": { "output": "x", "guards": [] }, "expect": { "passed": false } },
    { "name": "guard_fired with fired: false passes when it didn't", "grader": { "guard_fired": { "guard": "injection", "fired": false } },
      "sample": { "output": "x", "guards": [] }, "expect": { "passed": true } },
    { "name": "guard_fired with fired: false fails when it did", "grader": { "guard_fired": { "guard": "injection", "fired": false } },
      "sample": { "output": "x", "guards": [ { "guard": "guardrails.input[injection]", "action": "redact", "shadow": false } ] }, "expect": { "passed": false } },
    { "name": "guard_fired with an action", "grader": { "guard_fired": { "guard": "injection", "action": "escalate" } },
      "sample": { "output": null, "status": "blocked", "guards": [ { "guard": "guardrails.input[injection]", "action": "block", "shadow": false } ] }, "expect": { "passed": false } },
    { "name": "guard_fired needs every listed guard", "grader": { "guard_fired": ["injection", "pii"] },
      "sample": { "output": null, "guards": [ { "guard": "guardrails.input[injection]", "action": "block", "shadow": false } ] }, "expect": { "passed": false } },
    { "name": "an id matches only a whole bracketed id", "grader": { "guard_fired": "injection" },
      "sample": { "output": null, "guards": [ { "guard": "guardrails.input[my-injection]", "action": "block", "shadow": false } ] }, "expect": { "passed": false } },

    { "name": "status matches one status", "grader": { "status": "blocked" },
      "sample": { "output": null, "status": "blocked" }, "expect": { "passed": true } },
    { "name": "status matches any listed status", "grader": { "status": ["blocked", "awaiting_approval"] },
      "sample": { "output": "x", "status": "completed" }, "expect": { "passed": false } },
    { "name": "status must be a run status", "grader": { "status": "done" }, "expect": { "error": "invalid" } },

    { "name": "an unknown grader", "grader": { "nope": 1 }, "expect": { "error": "unknown" } }
  ]
}
