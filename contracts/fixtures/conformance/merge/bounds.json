{
  "suite": "merge",
  "description": "Bounds: values outside a profile's bounds fail, never clamped (R10).",
  "cases": [
    {
      "name": "a value above the maximum fails",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "max": 5
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "budgets": {
              "per_run": {
                "max_usd": 8
              }
            }
          }
        }
      ],
      "expect": {
        "error": "bound_violation",
        "bound": "budgets.per_run.max_usd"
      }
    },
    {
      "name": "a value within bounds is kept exactly",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "max": 5
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "budgets": {
              "per_run": {
                "max_usd": 2.5
              }
            }
          }
        }
      ],
      "expect": {
        "value": {
          "budgets": {
            "per_run": {
              "max_usd": 2.5
            }
          }
        }
      }
    },
    {
      "name": "the maximum itself is allowed",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "max": 5
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "budgets": {
              "per_run": {
                "max_usd": 5
              }
            }
          }
        }
      ],
      "expect": {
        "value": {
          "budgets": {
            "per_run": {
              "max_usd": 5
            }
          }
        }
      }
    },
    {
      "name": "a duration above the maximum fails",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.deadline": {
                "max": "30m"
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "budgets": {
              "per_run": {
                "deadline": "1h"
              }
            }
          }
        }
      ],
      "expect": {
        "error": "bound_violation",
        "bound": "budgets.per_run.deadline"
      }
    },
    {
      "name": "a duration within bounds is kept",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.deadline": {
                "max": "30m"
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "budgets": {
              "per_run": {
                "deadline": "20s"
              }
            }
          }
        }
      ],
      "expect": {
        "value": {
          "budgets": {
            "per_run": {
              "deadline": "20s"
            }
          }
        }
      }
    },
    {
      "name": "a duration below the minimum fails",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.deadline": {
                "min": "10s"
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "budgets": {
              "per_run": {
                "deadline": "5s"
              }
            }
          }
        }
      ],
      "expect": {
        "error": "bound_violation",
        "bound": "budgets.per_run.deadline"
      }
    },
    {
      "name": "task budgets are checked against per-run bounds",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "max": 5
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "tasks": {
              "t": {
                "budget": {
                  "max_usd": 8
                }
              }
            }
          }
        }
      ],
      "expect": {
        "error": "bound_violation",
        "bound": "budgets.per_run.max_usd"
      }
    },
    {
      "name": "a wildcard bound covers every task",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "tasks.*.budget.max_tool_calls": {
                "max": 50
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "tasks": {
              "a": {
                "budget": {
                  "max_tool_calls": 10
                }
              },
              "b": {
                "budget": {
                  "max_tool_calls": 100
                }
              }
            }
          }
        }
      ],
      "expect": {
        "error": "bound_violation",
        "bound": "tasks.*.budget.max_tool_calls"
      }
    },
    {
      "name": "bounds from several profiles all apply",
      "layers": [
        {
          "name": "security",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "max": 20
              }
            }
          }
        },
        {
          "name": "team",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "max": 10
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "budgets": {
              "per_run": {
                "max_usd": 15
              }
            }
          }
        }
      ],
      "expect": {
        "error": "bound_violation",
        "bound": "budgets.per_run.max_usd"
      }
    },
    {
      "name": "a profile's own value is checked against its bound",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "budgets": {
              "per_run": {
                "max_usd": 9
              }
            },
            "bounds": {
              "budgets.per_run.max_usd": {
                "max": 5
              }
            }
          }
        }
      ],
      "expect": {
        "error": "bound_violation",
        "bound": "budgets.per_run.max_usd"
      }
    },
    {
      "name": "a bound needs a min or a max",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {}
            }
          }
        }
      ],
      "expect": {
        "error": "spec_invalid"
      }
    },
    {
      "name": "a bound's min can't exceed its max",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "min": 5,
                "max": 1
              }
            }
          }
        }
      ],
      "expect": {
        "error": "spec_invalid"
      }
    },
    {
      "name": "a value that isn't a number can't meet a numeric bound",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "max": 5
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "budgets": {
              "per_run": {
                "max_usd": "cheap"
              }
            }
          }
        }
      ],
      "expect": {
        "error": "spec_invalid"
      }
    },
    {
      "name": "null at a path with a maximum removes the limit, so it fails",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "max": 5
              }
            },
            "budgets": {
              "per_run": {
                "max_usd": 2
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "budgets": {
              "per_run": {
                "max_usd": null
              }
            }
          }
        }
      ],
      "expect": {
        "error": "bound_violation",
        "bound": "budgets.per_run.max_usd"
      }
    },
    {
      "name": "null fails even when the org set no value",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "max": 5
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "budgets": {
              "per_run": {
                "max_usd": null
              }
            }
          }
        }
      ],
      "expect": {
        "error": "bound_violation",
        "bound": "budgets.per_run.max_usd"
      }
    },
    {
      "name": "null from an overlay fails too",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "max": 5
              }
            },
            "budgets": {
              "per_run": {
                "max_usd": 2
              }
            }
          }
        },
        {
          "name": "overlay",
          "kind": "overlay",
          "data": {
            "budgets": {
              "per_run": {
                "max_usd": null
              }
            }
          }
        }
      ],
      "expect": {
        "error": "bound_violation",
        "bound": "budgets.per_run.max_usd"
      }
    },
    {
      "name": "null at a path with only a minimum is fine",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "min": 1
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "budgets": {
              "per_run": {
                "max_usd": null
              }
            }
          }
        }
      ],
      "expect": {
        "value": {
          "budgets": {
            "per_run": {
              "max_usd": null
            }
          }
        }
      }
    },
    {
      "name": "a null the defaults left in place is not a removal",
      "layers": [
        {
          "name": "defaults",
          "kind": "defaults",
          "data": {
            "budgets": {
              "per_run": {
                "max_usd": null
              }
            }
          }
        },
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "max": 5
              }
            }
          }
        }
      ],
      "expect": {
        "value": {
          "budgets": {
            "per_run": {
              "max_usd": null
            }
          }
        }
      }
    },
    {
      "name": "null on a task budget still leaves the per-run bound in force",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "budgets.per_run.max_usd": {
                "max": 5
              }
            },
            "budgets": {
              "per_run": {
                "max_usd": 2
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "tasks": {
              "t": {
                "budget": {
                  "max_usd": null
                }
              }
            }
          }
        }
      ],
      "expect": {
        "value": {
          "budgets": {
            "per_run": {
              "max_usd": 2
            }
          },
          "tasks": {
            "t": {
              "budget": {
                "max_usd": null
              }
            }
          }
        }
      }
    },
    {
      "name": "a __proto__ key in a layer fails",
      "layers": [
        {
          "name": "app",
          "kind": "app",
          "data": {
            "tasks": {
              "__proto__": {
                "budget": {
                  "max_usd": 1
                }
              }
            }
          }
        }
      ],
      "expect": {
        "error": "spec_invalid"
      }
    },
    {
      "name": "a task named after an Object.prototype member is still bounded",
      "layers": [
        {
          "name": "org",
          "kind": "org",
          "data": {
            "bounds": {
              "tasks.*.budget.max_usd": {
                "max": 2
              }
            }
          }
        },
        {
          "name": "app",
          "kind": "app",
          "data": {
            "tasks": {
              "constructor": {
                "budget": {
                  "max_usd": 8
                }
              }
            }
          }
        }
      ],
      "expect": {
        "error": "bound_violation",
        "bound": "tasks.*.budget.max_usd"
      }
    }
  ]
}
