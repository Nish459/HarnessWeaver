{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harnessweaver:v1:policy-request",
  "title": "PolicyRequest",
  "$defs": {
    "JsonValue": {},
    "Labels": {
      "additionalProperties": false,
      "description": "What kind of data a run has touched. Drives the lethal-trifecta check (RULES S3).",
      "properties": {
        "data_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Classification of the run's data, e.g. 'confidential'.",
          "title": "Data Class"
        },
        "untrusted_seen": {
          "default": false,
          "description": "Untrusted content (retrieved context, tool output) entered.",
          "title": "Untrusted Seen",
          "type": "boolean"
        },
        "private_seen": {
          "default": false,
          "description": "Private data (e.g. PII) was read or found in the input.",
          "title": "Private Seen",
          "type": "boolean"
        },
        "sources": {
          "default": [],
          "description": "Where untrusted or private data came from, in order.",
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "title": "Labels",
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "description": "Who a run acts for.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "attrs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Attrs",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "Principal",
      "type": "object"
    },
    "Risk": {
      "description": "How much harm a misused call could do.",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Risk",
      "type": "string"
    },
    "SideEffect": {
      "description": "What a tool changes when it runs.",
      "enum": [
        "none",
        "read",
        "write_internal",
        "write_external",
        "destructive"
      ],
      "title": "SideEffect",
      "type": "string"
    },
    "ToolInfo": {
      "additionalProperties": false,
      "description": "The parts of a tool manifest that policies and middleware decide on.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "side_effect": {
          "$ref": "#/$defs/SideEffect",
          "default": "none"
        },
        "risk": {
          "$ref": "#/$defs/Risk",
          "default": "low"
        },
        "egress": {
          "default": [],
          "description": "Hosts the tool may reach.",
          "items": {
            "type": "string"
          },
          "title": "Egress",
          "type": "array"
        },
        "data_access": {
          "default": [],
          "description": "Data it reads, e.g. 'pii:x'.",
          "items": {
            "type": "string"
          },
          "title": "Data Access",
          "type": "array"
        },
        "scopes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The question a ``PolicyEngine`` answers: may this run, or this call, go ahead?",
  "properties": {
    "hook": {
      "default": "tool.before",
      "enum": [
        "tool.before",
        "run.start"
      ],
      "title": "Hook",
      "type": "string"
    },
    "principal": {
      "$ref": "#/$defs/Principal"
    },
    "tenant": {
      "title": "Tenant",
      "type": "string"
    },
    "task": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task"
    },
    "task_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Version"
    },
    "tool": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The tool, for tool.before."
    },
    "args": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The call's arguments.",
      "title": "Args"
    },
    "labels": {
      "$ref": "#/$defs/Labels",
      "default": {
        "data_class": null,
        "untrusted_seen": false,
        "private_seen": false,
        "sources": []
      }
    }
  },
  "required": [
    "principal",
    "tenant"
  ],
  "type": "object"
}
