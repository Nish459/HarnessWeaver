{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harnessweaver:v1:hook-event",
  "title": "HookEvent",
  "$defs": {
    "Acl": {
      "additionalProperties": false,
      "description": "Who may see a retrieved item. An empty list means \"no restriction\" for that part.",
      "properties": {
        "tenants": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tenants",
          "type": "array"
        },
        "principals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Principals",
          "type": "array"
        },
        "roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        }
      },
      "title": "Acl",
      "type": "object"
    },
    "ApprovalDecision": {
      "additionalProperties": false,
      "description": "A human's answer to an :class:`ApprovalRequest`.",
      "properties": {
        "approval_id": {
          "minLength": 1,
          "title": "Approval Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approve",
            "reject",
            "edit"
          ],
          "title": "Decision",
          "type": "string"
        },
        "approver": {
          "$ref": "#/$defs/Principal"
        },
        "edited_args": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edited Args"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "approval_id",
        "decision",
        "approver"
      ],
      "title": "ApprovalDecision",
      "type": "object"
    },
    "ApprovalRequest": {
      "additionalProperties": false,
      "description": "A suspended step waiting for a human.",
      "properties": {
        "approval_id": {
          "minLength": 1,
          "title": "Approval Id",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "approver_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approver Role"
        },
        "call": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCall"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        }
      },
      "required": [
        "approval_id",
        "run_id",
        "reason",
        "requested_at"
      ],
      "title": "ApprovalRequest",
      "type": "object"
    },
    "ApprovalResolvedEvent": {
      "additionalProperties": false,
      "properties": {
        "hook": {
          "const": "approval.resolved",
          "default": "approval.resolved",
          "title": "Hook",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ApprovalRequest"
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        }
      },
      "required": [
        "request",
        "decision"
      ],
      "title": "ApprovalResolvedEvent",
      "type": "object"
    },
    "ContextEvent": {
      "additionalProperties": false,
      "properties": {
        "hook": {
          "const": "context.after",
          "default": "context.after",
          "title": "Hook",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "source"
      ],
      "title": "ContextEvent",
      "type": "object"
    },
    "ContextItem": {
      "additionalProperties": false,
      "description": "One retrieved document or memory entry.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "source": {
          "description": "Where the item came from, e.g. the context provider name.",
          "title": "Source",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "untrusted": {
          "default": true,
          "title": "Untrusted",
          "type": "boolean"
        },
        "acl": {
          "anyOf": [
            {
              "$ref": "#/$defs/Acl"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "content",
        "source"
      ],
      "title": "ContextItem",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "A router's answer, with the stage and reason that produced it (R13).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/DecisionKind"
        },
        "choice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choice"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The cascade stage that answered.",
          "title": "Stage"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Decision",
      "type": "object"
    },
    "DecisionKind": {
      "description": "How a decision was reached.",
      "enum": [
        "exact",
        "probabilistic",
        "abstain",
        "default"
      ],
      "title": "DecisionKind",
      "type": "string"
    },
    "DecisionRequest": {
      "additionalProperties": false,
      "description": "A question for a router: pick one of ``options`` for ``text`` and ``state``.",
      "properties": {
        "router": {
          "minLength": 1,
          "title": "Router",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "options": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "state": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "State",
          "type": "object"
        }
      },
      "required": [
        "router"
      ],
      "title": "DecisionRequest",
      "type": "object"
    },
    "ErrorCode": {
      "description": "Stable, language-neutral error codes.",
      "enum": [
        "budget_exceeded",
        "deadline_exceeded",
        "policy_denied",
        "validation_failed",
        "provider_error",
        "tool_error",
        "expression_error",
        "spec_invalid",
        "not_found",
        "blocked",
        "escalated",
        "suspended",
        "internal"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "The serializable form of an error, as carried by hook events and the wire API.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "type": {
          "description": "The error class name, e.g. 'LockViolation'.",
          "title": "Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "type",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "InputEvent": {
      "additionalProperties": false,
      "properties": {
        "hook": {
          "const": "input.before",
          "default": "input.before",
          "title": "Hook",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "input"
      ],
      "title": "InputEvent",
      "type": "object"
    },
    "JsonValue": {},
    "Message": {
      "additionalProperties": false,
      "description": "One message in a model conversation.",
      "properties": {
        "role": {
          "$ref": "#/$defs/Role"
        },
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "tool_calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "title": "Tool Calls",
          "type": "array"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set on tool-result messages.",
          "title": "Tool Call Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "role"
      ],
      "title": "Message",
      "type": "object"
    },
    "ModelRequest": {
      "additionalProperties": false,
      "description": "A request to a model, by alias or concrete model name.",
      "properties": {
        "alias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Requested alias, e.g. 'fast'.",
          "title": "Alias"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concrete model, once resolved.",
          "title": "Model"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "title": "Messages",
          "type": "array"
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolSpec"
          },
          "title": "Tools",
          "type": "array"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON Schema the final output must satisfy.",
          "title": "Output Schema"
        },
        "temperature": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "max_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "stream": {
          "default": false,
          "title": "Stream",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "messages"
      ],
      "title": "ModelRequest",
      "type": "object"
    },
    "ModelRequestEvent": {
      "additionalProperties": false,
      "properties": {
        "hook": {
          "const": "model.before",
          "default": "model.before",
          "title": "Hook",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ModelRequest"
        }
      },
      "required": [
        "request"
      ],
      "title": "ModelRequestEvent",
      "type": "object"
    },
    "ModelResponse": {
      "additionalProperties": false,
      "description": "A model's answer.",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "tool_calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "title": "Tool Calls",
          "type": "array"
        },
        "output": {
          "$ref": "#/$defs/JsonValue",
          "default": null,
          "description": "Parsed structured output, if any."
        },
        "usage": {
          "$ref": "#/$defs/Usage",
          "default": {
            "input_tokens": 0,
            "output_tokens": 0
          }
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cost reported by the provider, if it reports one.",
          "title": "Cost Usd"
        },
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        }
      },
      "title": "ModelResponse",
      "type": "object"
    },
    "ModelResponseEvent": {
      "additionalProperties": false,
      "properties": {
        "hook": {
          "const": "model.after",
          "default": "model.after",
          "title": "Hook",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ModelRequest"
        },
        "response": {
          "$ref": "#/$defs/ModelResponse"
        }
      },
      "required": [
        "request",
        "response"
      ],
      "title": "ModelResponseEvent",
      "type": "object"
    },
    "OutputEvent": {
      "additionalProperties": false,
      "properties": {
        "hook": {
          "const": "output.before",
          "default": "output.before",
          "title": "Hook",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/JsonValue"
        },
        "attempt": {
          "default": 0,
          "description": "0 for the first answer, then repairs.",
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "schema_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Name"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A human's approval of this output; don't ask again."
        }
      },
      "required": [
        "output"
      ],
      "title": "OutputEvent",
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "description": "Who a run acts for.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "attrs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Attrs",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "Principal",
      "type": "object"
    },
    "Risk": {
      "description": "How much harm a misused call could do.",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Risk",
      "type": "string"
    },
    "Role": {
      "description": "Who wrote a message.",
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ],
      "title": "Role",
      "type": "string"
    },
    "RouteEvent": {
      "additionalProperties": false,
      "properties": {
        "hook": {
          "const": "route.decide",
          "default": "route.decide",
          "title": "Hook",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/DecisionRequest"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decision"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set by the middleware (usually routing) that decides."
        }
      },
      "required": [
        "request"
      ],
      "title": "RouteEvent",
      "type": "object"
    },
    "RunEndEvent": {
      "additionalProperties": false,
      "properties": {
        "hook": {
          "const": "run.end",
          "default": "run.end",
          "title": "Hook",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "output": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "usage": {
          "$ref": "#/$defs/Usage",
          "default": {
            "input_tokens": 0,
            "output_tokens": 0
          }
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        }
      },
      "required": [
        "status"
      ],
      "title": "RunEndEvent",
      "type": "object"
    },
    "RunErrorEvent": {
      "additionalProperties": false,
      "properties": {
        "hook": {
          "const": "run.error",
          "default": "run.error",
          "title": "Hook",
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/ErrorInfo"
        },
        "step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        }
      },
      "required": [
        "error"
      ],
      "title": "RunErrorEvent",
      "type": "object"
    },
    "RunStartEvent": {
      "additionalProperties": false,
      "properties": {
        "hook": {
          "const": "run.start",
          "default": "run.start",
          "title": "Hook",
          "type": "string"
        },
        "task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task"
        },
        "input": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "title": "RunStartEvent",
      "type": "object"
    },
    "RunStatus": {
      "description": "Where a run is in its lifecycle (DESIGNS No. 18).",
      "enum": [
        "pending",
        "running",
        "awaiting_approval",
        "completed",
        "blocked",
        "escalated",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SideEffect": {
      "description": "What a tool changes when it runs.",
      "enum": [
        "none",
        "read",
        "write_internal",
        "write_external",
        "destructive"
      ],
      "title": "SideEffect",
      "type": "string"
    },
    "StreamChunk": {
      "additionalProperties": false,
      "description": "One piece of a streamed model response.",
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "delta": {
          "default": "",
          "title": "Delta",
          "type": "string"
        },
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        }
      },
      "required": [
        "index"
      ],
      "title": "StreamChunk",
      "type": "object"
    },
    "StreamChunkEvent": {
      "additionalProperties": false,
      "properties": {
        "hook": {
          "const": "stream.chunk",
          "default": "stream.chunk",
          "title": "Hook",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ModelRequest"
        },
        "chunk": {
          "$ref": "#/$defs/StreamChunk"
        },
        "text_so_far": {
          "default": "",
          "title": "Text So Far",
          "type": "string"
        }
      },
      "required": [
        "request",
        "chunk"
      ],
