{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harnessweaver:v1:run-event",
  "title": "RunEvent",
  "$defs": {
    "ApprovalRequest": {
      "additionalProperties": false,
      "description": "A suspended step waiting for a human.",
      "properties": {
        "approval_id": {
          "minLength": 1,
          "title": "Approval Id",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "approver_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approver Role"
        },
        "call": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCall"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        }
      },
      "required": [
        "approval_id",
        "run_id",
        "reason",
        "requested_at"
      ],
      "title": "ApprovalRequest",
      "type": "object"
    },
    "Band": {
      "description": "Middleware priority bands, outermost first.\n\nThe spec assigns bands; a plugin can't place itself in ``baseline`` (S8).",
      "enum": [
        "baseline",
        "platform",
        "app",
        "task"
      ],
      "title": "Band",
      "type": "string"
    },
    "HookPoint": {
      "description": "A named moment in the run lifecycle. The set is fixed and versioned (R11).",
      "enum": [
        "run.start",
        "input.before",
        "route.decide",
        "context.after",
        "model.before",
        "model.after",
        "stream.chunk",
        "tool.before",
        "tool.after",
        "output.before",
        "approval.resolved",
        "run.error",
        "run.end"
      ],
      "title": "HookPoint",
      "type": "string"
    },
    "JsonValue": {},
    "OutcomeKind": {
      "enum": [
        "continue",
        "retry",
        "escalate",
        "suspend",
        "block"
      ],
      "title": "OutcomeKind",
      "type": "string"
    },
    "Risk": {
      "description": "How much harm a misused call could do.",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Risk",
      "type": "string"
    },
    "RunStatus": {
      "description": "Where a run is in its lifecycle (DESIGNS No. 18).",
      "enum": [
        "pending",
        "running",
        "awaiting_approval",
        "completed",
        "blocked",
        "escalated",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SideEffect": {
      "description": "What a tool changes when it runs.",
      "enum": [
        "none",
        "read",
        "write_internal",
        "write_external",
        "destructive"
      ],
      "title": "SideEffect",
      "type": "string"
    },
    "StreamChunk": {
      "additionalProperties": false,
      "description": "One piece of a streamed model response.",
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "delta": {
          "default": "",
          "title": "Delta",
          "type": "string"
        },
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        }
      },
      "required": [
        "index"
      ],
      "title": "StreamChunk",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "A tool call proposed by a model.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ToolInfo": {
      "additionalProperties": false,
      "description": "The parts of a tool manifest that policies and middleware decide on.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "side_effect": {
          "$ref": "#/$defs/SideEffect",
          "default": "none"
        },
        "risk": {
          "$ref": "#/$defs/Risk",
          "default": "low"
        },
        "egress": {
          "default": [],
          "description": "Hosts the tool may reach.",
          "items": {
            "type": "string"
          },
          "title": "Egress",
          "type": "array"
        },
        "data_access": {
          "default": [],
          "description": "Data it reads, e.g. 'pii:x'.",
          "items": {
            "type": "string"
          },
          "title": "Data Access",
          "type": "array"
        },
        "scopes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolInfo",
      "type": "object"
    },
    "TraceEvent": {
      "additionalProperties": false,
      "description": "One entry in a :class:`RunTrace`.",
      "properties": {
        "seq": {
          "description": "Position in the run's trace, from 0.",
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TraceKind"
        },
        "source": {
          "description": "Middleware name, or 'harness.<area>'.",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "hook": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookPoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "band": {
          "anyOf": [
            {
              "$ref": "#/$defs/Band"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutcomeKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modified": {
          "default": false,
          "description": "The middleware changed the payload.",
          "title": "Modified",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "seq",
        "at",
        "kind",
        "source"
      ],
      "title": "TraceEvent",
      "type": "object"
    },
    "TraceKind": {
      "description": "What a trace event records.",
      "enum": [
        "hook",
        "outcome",
        "failure",
        "note"
      ],
      "title": "TraceKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Progress of a run, as yielded by ``harness.stream(run_id)``.\n\n``status`` and ``approval`` events are kept in the state store's event log;\n``trace`` and ``chunk`` events are only delivered live.",
  "properties": {
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "type": {
      "enum": [
        "status",
        "trace",
        "chunk",
        "approval"
      ],
      "title": "Type",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trace": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceEvent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "chunk": {
      "anyOf": [
        {
          "$ref": "#/$defs/StreamChunk"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "seq",
    "at",
    "type"
  ],
  "type": "object"
}
