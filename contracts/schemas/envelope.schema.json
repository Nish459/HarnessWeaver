{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harnessweaver:v1:envelope",
  "title": "Envelope",
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "description": "Limits for one run. ``None`` means no limit at this layer.",
      "properties": {
        "max_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Usd"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_model_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Calls"
        },
        "max_tool_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tool Calls"
        },
        "deadline": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "pattern": "^(\\d+(\\.\\d+)?(ms|d|h|m|s))+$",
                  "type": "string"
                },
                {
                  "minimum": 0,
                  "type": "number"
                }
              ],
              "description": "A duration such as '250ms', '20s', '5m' or '1h30m', or a number of seconds."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "JsonValue": {},
    "Labels": {
      "additionalProperties": false,
      "description": "What kind of data a run has touched. Drives the lethal-trifecta check (RULES S3).",
      "properties": {
        "data_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Classification of the run's data, e.g. 'confidential'.",
          "title": "Data Class"
        },
        "untrusted_seen": {
          "default": false,
          "description": "Untrusted content (retrieved context, tool output) entered.",
          "title": "Untrusted Seen",
          "type": "boolean"
        },
        "private_seen": {
          "default": false,
          "description": "Private data (e.g. PII) was read or found in the input.",
          "title": "Private Seen",
          "type": "boolean"
        },
        "sources": {
          "default": [],
          "description": "Where untrusted or private data came from, in order.",
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "title": "Labels",
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "description": "Who a run acts for.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "attrs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Attrs",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "Principal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The immutable context every hook event carries.",
  "properties": {
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Run Id"
    },
    "tenant": {
      "minLength": 1,
      "title": "Tenant",
      "type": "string"
    },
    "principal": {
      "$ref": "#/$defs/Principal"
    },
    "task": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task"
    },
    "task_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Version"
    },
    "budget": {
      "$ref": "#/$defs/Budget",
      "default": {
        "max_usd": null,
        "max_tokens": null,
        "max_model_calls": null,
        "max_tool_calls": null,
        "deadline": null
      }
    },
    "deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline"
    },
    "labels": {
      "$ref": "#/$defs/Labels",
      "default": {
        "data_class": null,
        "untrusted_seen": false,
        "private_seen": false,
        "sources": []
      }
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "attributes": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Free-form app tags, e.g. channel or region.",
      "title": "Attributes",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "tenant",
    "principal"
  ],
  "type": "object"
}
