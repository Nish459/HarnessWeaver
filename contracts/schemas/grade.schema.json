{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harnessweaver:v1:grade",
  "title": "Grade",
  "additionalProperties": false,
  "description": "What an ``Evaluator`` says about one sample.",
  "properties": {
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Names fields and rules, not content.",
      "title": "Reason"
    }
  },
  "required": [
    "passed",
    "score"
  ],
  "type": "object"
}
