  "title": "ToolCall",
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "A tool call proposed by a model.",
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "arguments": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Arguments",
      "type": "object"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "type": "object"
}
