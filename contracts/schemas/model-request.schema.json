{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harnessweaver:v1:model-request",
  "title": "ModelRequest",
  "$defs": {
    "JsonValue": {},
    "Message": {
      "additionalProperties": false,
      "description": "One message in a model conversation.",
      "properties": {
        "role": {
          "$ref": "#/$defs/Role"
        },
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "tool_calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "title": "Tool Calls",
          "type": "array"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set on tool-result messages.",
          "title": "Tool Call Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "Provider data to replay unchanged with this message, keyed by provider namespace (for example a model's own reasoning blocks). Opaque to the harness.",
          "title": "Extensions",
          "type": "object"
        }
      },
      "required": [
        "role"
      ],
      "title": "Message",
      "type": "object"
    },
    "Role": {
      "description": "Who wrote a message.",
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ],
      "title": "Role",
      "type": "string"
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "A tool call proposed by a model.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ToolSpec": {
      "additionalProperties": false,
      "description": "A tool as offered to a model.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Input Schema",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A request to a model, by alias or concrete model name.",
  "properties": {
    "alias": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Requested alias, e.g. 'fast'.",
      "title": "Alias"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Concrete model, once resolved.",
      "title": "Model"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "title": "Messages",
      "type": "array"
    },
    "tools": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolSpec"
      },
      "title": "Tools",
      "type": "array"
    },
    "output_schema": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "JSON Schema the final output must satisfy.",
      "title": "Output Schema"
    },
    "temperature": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "max_tokens": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Tokens"
    },
    "stream": {
      "default": false,
      "title": "Stream",
      "type": "boolean"
    },
    "metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "messages"
  ],
  "type": "object"
}
