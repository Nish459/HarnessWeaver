{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harnessweaver:v1:recorded-call",
  "title": "RecordedCall",
  "$defs": {
    "ApprovalDecision": {
      "additionalProperties": false,
      "description": "A human's answer to an :class:`ApprovalRequest`.",
      "properties": {
        "approval_id": {
          "minLength": 1,
          "title": "Approval Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approve",
            "reject",
            "edit"
          ],
          "title": "Decision",
          "type": "string"
        },
        "approver": {
          "$ref": "#/$defs/Principal"
        },
        "edited_args": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edited Args"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "approval_id",
        "decision",
        "approver"
      ],
      "title": "ApprovalDecision",
      "type": "object"
    },
    "JsonValue": {},
    "ModelResponse": {
      "additionalProperties": false,
      "description": "A model's answer.",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "tool_calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "title": "Tool Calls",
          "type": "array"
        },
        "output": {
          "$ref": "#/$defs/JsonValue",
          "default": null,
          "description": "Parsed structured output, if any."
        },
        "usage": {
          "$ref": "#/$defs/Usage",
          "default": {
            "input_tokens": 0,
            "output_tokens": 0
          }
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cost reported by the provider, if it reports one.",
          "title": "Cost Usd"
        },
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "Provider data the next request should replay with this answer; runners copy it onto the assistant message they add to the history.",
          "title": "Extensions",
          "type": "object"
        }
      },
      "title": "ModelResponse",
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "description": "Who a run acts for.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "attrs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Attrs",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "Principal",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "A tool call proposed by a model.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "description": "What a tool returned. Output is untrusted unless the manifest says otherwise (S3).",
      "properties": {
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "is_error": {
          "default": false,
          "title": "Is Error",
          "type": "boolean"
        },
        "untrusted": {
          "default": true,
          "title": "Untrusted",
          "type": "boolean"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "call_id"
      ],
      "title": "ToolResult",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Token usage of one or more model calls.",
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What a recorded run got from outside: a model's answer, a tool's result, or a\nhuman's approval, in order (``state.record: true``, ADR-0035).\n\n``harnessweaver replay`` feeds these back to the run instead of calling out.\nUnlike traces, recordings hold content: the state store keeps them like it\nkeeps a run's input, and they are off unless the spec turns them on (R9).",
  "properties": {
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "kind": {
      "enum": [
        "model",
        "tool",
        "approval"
      ],
      "title": "Kind",
      "type": "string"
    },
    "digest": {
      "description": "model: request_digest of the request; tool: call_digest; approval: call_digest or output_digest of what it covers.",
      "title": "Digest",
      "type": "string"
    },
    "response": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "hook": {
      "anyOf": [
        {
          "enum": [
            "tool.before",
            "output.before"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hook"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "seq",
    "kind",
    "digest"
  ],
  "type": "object"
}
